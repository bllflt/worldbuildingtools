#!/usr/bin/env bash

SESSION="dev_env"

# Kill any existing session to avoid conflicts
screen -S "$SESSION" -X quit 2>/dev/null || true

# 1. Start a new detached session with the first window (shell)
screen -dmS "$SESSION" -t shell /bin/zsh  

# Wait for session to initialize
sleep 2

# Check if session was created
if ! screen -ls | grep -q "$SESSION"; then
    echo "Failed to create screen session '$SESSION'"
    exit 1
fi

# 2. Create a new window for FastAPI
screen -S "$SESSION" -X screen  # Creates window 1 and selects it
screen -S "$SESSION" -X title fastapi
screen -S "$SESSION" -X stuff "cd ~/automatic-picture-inserter && source venv/bin/activate && cd src/charservice && fastapi dev main.py --port 2000\n"
screen -S "$SESSION" -X select 0  # Select back to window 0 

# 3. Create a new window for Frontend
screen -S "$SESSION" -X screen  # Creates window 2 and selects it
screen -S "$SESSION" -X title frontend
screen -S "$SESSION" -X stuff "cd ~/wb-bront && npm run dev\n"
screen -S "$SESSION" -X select 0  # Select back to window 0 

# 4. Create a new window for LLM Proxy
screen -S "$SESSION" -X screen  # Creates window 3 and selects it
screen -S "$SESSION" -X title llm_proxy 
screen -S "$SESSION" -X stuff "cd ~/llm_proxy && source venv/bin/activate && cd app && fastapi dev main.py --port 4000\n"
screen -S "$SESSION" -X select 0  # Select back to window 0

echo "Screen session '$SESSION' created with windows: redis, fastapi, llm_proxy, frontend"
echo "Attach with: screen -r $SESSION"
